# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr

# pnpm is the repo lockfile — avoid nested npm locks from accidental npm install
packages/**/package-lock.json

# ─── Secrets & local env (never commit real keys) ─────────────────────────────
.env
.env.*
!.env.example
# Next / tooling local overlays (also matched by `.env.*` above)
.env.local
.env.development.local
.env.test.local
.env.production.local
# Any file suffixed `.local` (e.g. other tool-specific secrets)
*.local

# Keys & certificates
*.pem
*.key
*.p12
*.pfx

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
# macOS AppleDouble / resource forks (ExFAT, SMB, external volumes — never commit)
**/._*
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Electron build output
release/
.webpack/

# Next.js
.next/
out/

# Hosting / caches (often contain tokens or paths)
.vercel/

# Direnv (can export secrets)
.envrc
.vercel

# Local FilmCraft handoff packages
.data/

