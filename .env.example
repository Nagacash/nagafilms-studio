# Copy to `.env.local` for local development. Do not commit secrets.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=generate-with-openssl-rand-base64-32
ADMIN_EMAILS=
# AUTH_URL=http://localhost:3000

# --- Database (Neon Postgres) ---
DATABASE_URL=

# --- Optional OAuth ---
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# --- Stripe (one-time credit packs only — no subscriptions) ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_PRO=
